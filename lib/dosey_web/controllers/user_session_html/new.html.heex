<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-[#f7faf8] text-[#172526]">
  <section class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-6 py-12">
    <a href={~p"/"} class="mb-10 flex w-fit items-center gap-3">
      <img src={~p"/images/dosey-logo.png"} alt="Dosey logo" class="h-11 w-11 rounded-lg" />
      <span class="text-xl font-semibold">Dosey</span>
    </a>

    <div>
      <h1 class="text-4xl font-semibold tracking-normal text-[#102021]">Log ind</h1>
      <p class="mt-3 text-base leading-7 text-[#4f5f5c]">
        Log ind for at åbne den private medicindagbog.
      </p>
    </div>

    <%= if @error_message do %>
      <p class="mt-6 rounded-lg border border-[#ffd2c6] bg-[#fff1ed] px-4 py-3 text-sm font-medium text-[#9a3412]">
        {@error_message}
      </p>
    <% end %>

    <form action={~p"/login"} method="post" class="mt-8 space-y-5">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

      <label class="block">
        <span class="text-sm font-medium text-[#344845]">Email</span>
        <input
          type="email"
          name="user[email]"
          value={@email}
          autocomplete="email"
          required
          class="mt-2 block w-full rounded-lg border border-[#cbd8d2] bg-white px-4 py-3 text-[#172526] outline-none focus:border-[#0b6f6b] focus:ring-2 focus:ring-[#92c7bc]"
        />
      </label>

      <label class="block">
        <span class="text-sm font-medium text-[#344845]">Adgangskode</span>
        <input
          type="password"
          name="user[password]"
          autocomplete="current-password"
          required
          class="mt-2 block w-full rounded-lg border border-[#cbd8d2] bg-white px-4 py-3 text-[#172526] outline-none focus:border-[#0b6f6b] focus:ring-2 focus:ring-[#92c7bc]"
        />
      </label>

      <button
        type="submit"
        class="w-full rounded-lg bg-[#0b6f6b] px-4 py-3 text-base font-semibold text-white hover:bg-[#084f4c] focus:outline-none focus:ring-2 focus:ring-[#92c7bc] focus:ring-offset-2"
      >
        Log ind
      </button>
    </form>
  </section>
</main>
