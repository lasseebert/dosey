<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-[#f7faf8] text-[#172526]">
  <section class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-6 py-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between">
      <img src={~p"/images/dosey-logo.png"} alt="Dosey logo" class="h-12 w-12 rounded-lg" />
      <span class="text-sm font-medium text-[#4f6c69]">Menu (placeholder)</span>
    </div>

    <div class="grid flex-1 items-center gap-12 py-12 lg:grid-cols-[1fr_22rem] lg:py-20">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-semibold tracking-normal text-[#102021] sm:text-6xl lg:text-7xl">
          Dosey
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-[#4f5f5c] sm:text-xl sm:leading-9">
          Dosey er en medicindagbog til privat brug. Den er ikke åben (endnu) for andre end mig :)
        </p>

        <address class="mt-10 not-italic">
          <p class="text-sm font-semibold uppercase tracking-wider text-[#687b76]">Kontakt</p>
          <p class="mt-3 text-lg font-medium text-[#172526]">Lasse Skindstad Ebert</p>
          <a
            href="mailto:lasse@lasseebert.dk"
            class="mt-1 inline-block text-lg text-[#0b6f6b] underline decoration-[#92c7bc] underline-offset-4 hover:text-[#084f4c]"
          >
            lasse@lasseebert.dk
          </a>
        </address>
      </div>

      <div class="justify-self-center lg:justify-self-end">
        <img
          src={~p"/images/dosey-logo.png"}
          alt=""
          class="h-64 w-64 rounded-[2rem] shadow-2xl shadow-[#285c58]/20 sm:h-80 sm:w-80"
        />
      </div>
    </div>
  </section>
</main>
